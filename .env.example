# Copie para .env e preencha. Nao commite o .env.

# development | production
# Em production, DATABASE_URL e JWT_SECRET_KEY passam a ser obrigatorias.
APP_ENV=development

# Em desenvolvimento pode ficar em branco (usa SQLite local).
# Em producao use a URL do Postgres. Aceita postgres:// ou postgresql://,
# a aplicacao normaliza para o driver psycopg 3.
DATABASE_URL=

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens extras do front, separadas por virgula. As de localhost ja entram
# por padrao. Ex.: https://seu-front.vercel.app
CORS_ORIGINS=

# Seed (app/seed.py). Sem SUPERUSER_PASSWORD o superuser nao e criado.
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
EMPLOYEE_DEFAULT_PASSWORD=
CLIENT_DEFAULT_PASSWORD=
